# Required: Telegram bot token from @BotFather.
TG_TOKEN=1234567890:replace_me

# Terminal logs: DEBUG shows the most bridge details, INFO is quieter.
LOG_LEVEL=DEBUG

# Required: Telegram forum supergroup id, for example -1001234567890.
# The bot needs admin rights to manage topics and send messages.
TG_GROUP_ID=-1001234567890

# Required: Facebook cookie for the Messenger account.
# Set the cookie directly or point to a local text file.
FACEBOOK_COOKIE=c_user=...; xs=...; fr=...; datr=...;
# FACEBOOK_COOKIE_FILE=./facebook-cookie.txt

# Optional: auto-login again with fbchat-v2 _facebookLogin.py when the cookie expires.
# Fill these only if you want the bridge to refresh a dead cookie automatically.
FACEBOOK_AUTO_RELOGIN=1
FACEBOOK_LOGIN_USERNAME=
FACEBOOK_LOGIN_PASSWORD=
FACEBOOK_LOGIN_2FA_SECRET=
FACEBOOK_COOKIE_SAVE_FILE=./facebook-cookie.txt

# Persistent storage for topic/message mapping.
DATA_DIR=./data

# fbchat-v2 2.3.x is installed from PyPI via requirements.txt.
# Leave the binary unset to let the package download and verify the matching release asset.
# FBCHAT_E2EE_BIN=C:/path/to/fbchat-bridge-e2ee.exe

FBCHAT_ENABLE_E2EE=1
FBCHAT_E2EE_MEMORY_ONLY=1
FBCHAT_E2EE_LOG_LEVEL=none
FBCHAT_E2EE_READY_TIMEOUT=90
FBCHAT_E2EE_SEND_TIMEOUT=180
# FBCHAT_E2EE_DEVICE_PATH=./data/e2ee-device.json

# Set to 0 to also bridge messages you send from other Messenger clients (phone, web).
# Echoes of messages the bridge itself sent from Telegram are still deduplicated.
IGNORE_SELF_MESSAGES=1
MESSAGE_CACHE_LIMIT=3000

# Telegram HTTP tuning. Increase these if Telegram API is slow from your network.
TG_CONNECT_TIMEOUT=15
TG_READ_TIMEOUT=45
TG_WRITE_TIMEOUT=45
TG_POOL_TIMEOUT=30

# Noisy Messenger activity. Keep off unless you really want high-volume status events.
FORWARD_MESSENGER_REACTIONS=1
FORWARD_TYPING_ACTIVITY=1
FORWARD_READ_RECEIPTS=0
